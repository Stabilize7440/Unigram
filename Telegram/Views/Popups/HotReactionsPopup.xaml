<controls:ContentPopup x:Class="Telegram.Views.Popups.HotReactionsPopup"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="using:Telegram.Controls"
                       xmlns:hot="using:Telegram.Services.HotReactions"
                       mc:Ignorable="d"
                       PrimaryButtonText="关闭"
                       PrimaryButtonClick="OnPrimaryButtonClick"
                       ContentMinWidth="480"
                       ContentMaxWidth="580"
                       Padding="20,16,20,12"
                       Loaded="OnPopupLoaded"
                       Unloaded="OnPopupUnloaded">

    <Grid MinHeight="450" MaxHeight="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行与刷新按钮 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔥" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="反应排行榜" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="RefreshButton" Content="刷新 ▾" Grid.Column="1" VerticalAlignment="Center">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="刷新近 7 天消息" Click="RefreshButton_Click" />
                        <MenuFlyoutItem Text="从头重扫频道历史" Click="ResetAndRescan_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 过滤切换栏：近7天 / 历史总榜 -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="WeekFilterBtn" Content="近 7 天热门" Click="FilterWeek_Click" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
            <Button x:Name="AllFilterBtn" Content="历史总榜" Click="FilterAll_Click" HorizontalAlignment="Stretch" Grid.Column="1" Margin="4,0,0,0" />
        </Grid>

        <!-- 情绪与倾向过滤栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RankNetPosBtn" Content="✨ 净正面" Click="RankNetPos_Click" HorizontalAlignment="Stretch" Margin="0,0,2,0" Padding="0,4" FontSize="12" />
            <Button x:Name="RankPosBtn" Content="🔥 赞赏" Click="RankPos_Click" HorizontalAlignment="Stretch" Grid.Column="1" Margin="2,0,2,0" Padding="0,4" FontSize="12" />
            <Button x:Name="RankNegBtn" Content="💩 翻车" Click="RankNeg_Click" HorizontalAlignment="Stretch" Grid.Column="2" Margin="2,0,2,0" Padding="0,4" FontSize="12" />
            <Button x:Name="RankShockBtn" Content="😱 震撼" Click="RankShock_Click" HorizontalAlignment="Stretch" Grid.Column="3" Margin="2,0,2,0" Padding="0,4" FontSize="12" />
            <Button x:Name="RankAllBtn" Content="🌐 全部" Click="RankAll_Click" HorizontalAlignment="Stretch" Grid.Column="4" Margin="2,0,2,0" Padding="0,4" FontSize="12" />
            <Button x:Name="SentimentConfigBtn" Content="⚙" Grid.Column="5" Margin="4,0,0,0" Padding="6,4" ToolTipService.ToolTip="自定义表情分类">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="260" Spacing="8">
                            <TextBlock Text="自定义表情倾向分类" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="为自定义或未收录的 Emoji 指定情绪倾向" FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ConfigEmojiInput" PlaceholderText="表情如 🎉" Margin="0,0,6,0" MaxLength="10" />
                                <ComboBox x:Name="ConfigCategorySelect" SelectedIndex="0" Grid.Column="1">
                                    <ComboBoxItem Content="正面/赞赏" />
                                    <ComboBoxItem Content="负面/翻车" />
                                    <ComboBoxItem Content="惊愕/吃瓜" />
                                </ComboBox>
                            </Grid>
                            <Button Content="添加 / 保存" Click="SaveConfigEmoji_Click" HorizontalAlignment="Stretch" Margin="0,2,0,0" />
                            <Button Content="重置为默认分类" Click="ResetConfigEmoji_Click" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" FontSize="12" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 门槛控制行 -->
        <Grid Grid.Row="3" Margin="0,0,0,8" Padding="10,6" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" CornerRadius="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ThresholdInfoText" Text="准入门槛: 计算中..." FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <TextBox x:Name="ThresholdInput" Width="70" PlaceholderText="阈值" Margin="8,0,4,0" Grid.Column="1" VerticalAlignment="Center" InputScope="Number" />
            <Button x:Name="SetThresholdBtn" Content="应用" Click="SetThreshold_Click" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>

        <!-- 列表内容 -->
        <Grid Grid.Row="4">
            <ListView x:Name="MessagesList"
                      IsItemClickEnabled="True"
                      ItemClick="OnMessageClick"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2,0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="hot:HotMessageItem">
                        <Grid Padding="10,8" CornerRadius="6" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧徽章 -->
                            <Border Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                    CornerRadius="14"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{x:Bind BadgeText}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            </Border>

                            <!-- 中间内容 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Bind SenderName}" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    <TextBlock Text="{x:Bind FormattedDate}" FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind SubDetailText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="{x:Bind SubDetailVisibility}" Margin="0,1,0,0" />
                                <TextBlock Text="{x:Bind Snippet}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 右侧多媒体指示 -->
                            <TextBlock Text="📎" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Visibility="{x:Bind MediaVisibility}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyNotice"
                       Text="暂无满足阈值的热门消息"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Visibility="Collapsed" />

            <ProgressRing x:Name="LoadingRing"
                          IsActive="True"
                          Width="36"
                          Height="36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>

        <!-- 分页控制栏 -->
        <Grid x:Name="PaginationGrid" Grid.Row="5" Margin="0,6,0,0" Padding="8,4" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PaginationSummaryText" Text="共 0 条热门神帖" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="PrevPageBtn" Content="◀ 上一页" Click="PrevPage_Click" FontSize="11" Padding="8,3" />
                <TextBlock x:Name="PageNumText" Text="1 / 1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0" />
                <Button x:Name="NextPageBtn" Content="下一页 ▶" Click="NextPage_Click" FontSize="11" Padding="8,3" />
            </StackPanel>
        </Grid>

        <!-- 底部慢爬状态与控制 -->
        <Grid Grid.Row="6" Margin="0,6,0,0" Padding="8,4" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CrawlerStatusText" Text="冷区同步准备中..." FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="CrawlerToggleBtn" Content="暂停慢爬" Click="CrawlerToggle_Click" FontSize="11" Padding="8,2" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</controls:ContentPopup>
